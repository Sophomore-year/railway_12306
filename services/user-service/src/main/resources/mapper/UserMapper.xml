<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zys.railway_12306.service.user.mapper.UserMapper">

    <!-- 注销用户 -->
    <update id="deletionUser" parameterType="org.zys.railway_12306.service.user.pojo.entity.User">
        update t_user
        set deletion_time = #{deletionTime},
            del_flag      = '1'
        where username = #{username} and del_flag = '0'
    </update>
</mapper>
